  "cards": [
    {
      "dot": "rose",
      "title": "三个不可代签的决定",
      "items": [
        "req confirm：stakeholder 确认共识 → NEW 变 TRIAGED",
        "req plan：需求负责人同意并给版本 → TRIAGED 变 PLANNED",
        "prd submit-review 与 prd approve 是两个独立确认点，不能合并"
      ]
    },
    {
      "dot": "amber",
      "title": "失败一律零副作用",
      "items": [
        "职责不匹配 → ROLE_MISMATCH，状态不变",
        "缺 --actor 或 --confirm → CONFIRMATION_REQUIRED",
        "缺目标版本 → RELEASE_REQUIRED，不猜版本",
        "PRD 自审有 error → VALIDATION_FAILED，不得批准"
      ]
    },
    {
      "dot": "cyan",
      "title": "hash 只覆盖三样",
      "items": [
        "prd.md 正文",
        "metadata 中的锁定范围字段",
        "存在的 test-cases.md",
        "reviews/、changes/、history、status 是追加记录，不计入 hash"
      ]
    }
  ]
