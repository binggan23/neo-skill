  "cards": [
    {
      "dot": "amber",
      "title": "门禁十项（任一不过就零写入）",
      "items": [
        "显式绑定 PRD、PRD 存在、状态允许、批准记录有效",
        "hash 一致、项目约束已确认、团队已配置",
        "主需求关系正确、模块与目录一致、上一轮基线有效"
      ]
    },
    {
      "dot": "emerald",
      "title": "验证证据是交付物，不是摘要",
      "items": [
        "raw-*.log 逐字节原样保存",
        "单独记退出码、执行环境、代码版本",
        "未执行/阻塞/失败不得记成 pass；不适用必须写理由",
        "guard 检删除用例、弱化断言、跳测试、改 AC"
      ]
    },
    {
      "dot": "rose",
      "title": "ACCEPTED ≠ 完成",
      "items": [
        "收尾事务同步功能现状、场景状态、三个索引",
        "主需求 DONE 永远排在最后一步",
        "部分失败保留「已确认通过，收尾未完成」，用 recover run 续跑"
      ]
    }
  ]
